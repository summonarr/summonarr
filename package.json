{
  "name": "summonarr",
  "version": "0.27.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node node_modules/tsgo/bin/tsc --noEmit",
    "typecheck:classic": "node node_modules/typescript/bin/tsc --noEmit",
    "audit:deps": "node scripts/audit-deps.mts",
    "security:gate": "node scripts/audit-deps.mts --allowlist --no-outdated",
    "security:exceptions": "node scripts/audit-deps.mts --allowlist-only",
    "audit:routes": "node scripts/audit-routes.mts",
    "audit:openapi": "node scripts/audit-openapi.mts",
    "audit:tw-merge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-tw-merge.mts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/_loader.mjs --test tests/*.test.mts",
    "smoke:security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/_loader.mjs scripts/smoke-test-security.ts",
    "licenses:generate": "node scripts/generate-licenses.mts",
    "licenses:check": "node scripts/generate-licenses.mts --check",
    "postinstall": "node scripts/patch-eslint-plugin-react.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "brace-expansion@5": "^5.0.9",
    "minimatch": {
      "brace-expansion": "^5.0.9"
    },
    "fast-uri": "^3.1.6",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.23.1",
    "browserslist": "^4.28.7",
    "@humanfs/node": "^0.16.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.1",
    "tsgo": "npm:typescript@^7.0.2",
    "typescript": "^6"
  }
}
